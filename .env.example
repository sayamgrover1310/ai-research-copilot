# Copy this file to .env when configuration values are needed.
# Never commit the real .env file.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct

# Local storage locations used by future ingestion and retrieval features.
UPLOADS_DIRECTORY=data/uploads
CHROMA_PERSIST_DIRECTORY=data/chroma
