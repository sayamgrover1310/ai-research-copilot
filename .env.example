# Copy this file to .env when configuration values are needed.
# Never commit the real .env file.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct

# Web research uses Tavily. Create a key at https://tavily.com/ and keep it private.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

# Bounded Deep Research settings. Keep these small for predictable cost and runtime.
DEEP_RESEARCH_MAX_QUERIES=4
DEEP_RESEARCH_RESULTS_PER_QUERY=2
DEEP_RESEARCH_MAX_EVIDENCE=6
DEEP_RESEARCH_MAX_CONTENT_CHARS=600

# Study Mode generation limits.
STUDY_QUIZ_MAX_QUESTIONS=10
STUDY_FLASHCARD_MAX_COUNT=20

# Local storage locations for uploaded documents and persistent Chroma data.
UPLOADS_DIRECTORY=data/uploads
CHROMA_PERSIST_DIRECTORY=data/chroma
